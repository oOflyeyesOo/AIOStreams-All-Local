# ==============================================================================
#                      ALL-IN-ONE LOCAL STREMIO APPLIANCE (.env)
# ==============================================================================
# 💡 THE GOLDEN RULE: WHAT IS ACTUALLY NEEDED?
# You only need to configure 3 simple values to start streaming immediately:
#   1. BASE_URL          -> Your server domain or local IP (e.g. http://localhost:3001)
#   2. DEBRID API TOKEN  -> Pick just ONE service (Real-Debrid, TorBox, or AllDebrid)
#   3. TMDB_API_KEY      -> Free metadata API key from themoviedb.org
#
# Everything else is either an OPTIONAL enhancement or PRE-CONFIGURED internally!
# ==============================================================================

# ==============================================================================
# 0. STACK PROFILES & RESOURCE TUNING
# ==============================================================================
# Choose which container profile to launch:
#   all      - Complete appliance with all 20+ services (default)
#   core     - Fast, lean Debrid stack (AIOStreams, Comet, AIOMetadata, Posters+, SubSense, DBs) [~1.2 GB RAM]
#   scrapers - Core + MediaFusion, Sootio, Zilean, Prowlarr, FlareSolverr [~3.5 GB RAM]
#   proxies  - Core + MediaFlow, StremThru, InfiniDysk Usenet
#   web      - Core + Stremio Web, Nuvio, SlickSync
COMPOSE_PROFILES=all

# ==============================================================================
# 1. CORE STREAMING SETTINGS (REQUIRED)
# ==============================================================================
# Public HTTPS URL of your AIOStreams instance (Required for Stremio client install)
# Connected via Cloudflare Tunnel or reverse proxy to host port 3001
BASE_URL=https://aio.yourdomain.com
PORT_AIOSTREAMS=3001

# Public HTTPS URL of your AIOMetadata instance (External catalog & metadata addon)
# Connected via Cloudflare Tunnel or reverse proxy to host port 4005
AIOMETADATA_HOST=https://aiometa.yourdomain.com
PORT_AIOMETADATA=4005
PORT_DEBRID_SEARCH=3011

# Security & Host Port Binding
# Only AIOStreams (3001) and AIOMetadata (4005) are published for external remote streaming.
# Internal microservices (Comet, MediaFusion, Sootio, Prowlarr, Posters+, etc.) bind to 127.0.0.1
# to protect against unfirewalled exposure on a VPS or public IP.
# If you run on a private home LAN NAS and want direct LAN access to internal dashboards, set to 0.0.0.0.
INTERNAL_BIND_IP=127.0.0.1

# Master Password (ADDON_PASSWORD)
# 🔑 UNIFIES & PROTECTS ALL 7 WEB DASHBOARDS:
#   • AIOStreams (:3001)    • Comet (:8000)       • MediaFusion (:8001)
#   • SlickSync (:8086)     • AIOMetadata (:4005) • InfiniDysk (:3005)
#   • MediaFlow (:8888)
ADDON_PASSWORD=

# TMDB v3 API Key (Required for movie/series metadata: https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# ------------------------------------------------------------------------------
# 2. DEBRID SERVICE API TOKENS (Provide at least ONE provider, not all!)
# ------------------------------------------------------------------------------
# Real-Debrid API Token (from https://real-debrid.com/apitoken)
REALDEBRID_API_KEY=
# TorBox API Token (from https://torbox.app/settings)
TORBOX_API_KEY=
# AllDebrid API Key (from https://alldebrid.com/apikeys)
ALLDEBRID_API_KEY=
# Premiumize API Key (from https://www.premiumize.me/account)
PREMIUMIZE_API_KEY=
# Debrid-Link API Key (from https://debrid-link.com/webapp/register)
DEBRIDLINK_API_KEY=
# EasyDebrid API Key (Optional)
EASYDEBRID_API_KEY=
# Offcloud API Key (Optional)
OFFCLOUD_API_KEY=
# Seedr Token (Optional)
SEEDR_API_KEY=

# ------------------------------------------------------------------------------
# 2B. USENET (NNTP) CREDENTIALS (FOR ON-DEMAND USENET STREAMING VIA INFINIDYSK)
# ------------------------------------------------------------------------------
# Usenet Server Hostname (e.g. news.eweka.nl, news.usenet.farm, or secure.news.easynews.com)
USENET_HOST=
USENET_PORT=563
USENET_USER=
USENET_PASS=
USENET_SSL=true

# InfiniDysk headless provider settings use a single JSON object (optional).
# Leave blank to configure providers in its web UI. Existing USENET_* fields above
# are retained for the bootstrap/configurator and do not configure InfiniDysk.
# Example (use your own host/credentials):
# INFINIDYSK_USENET_PROVIDERS={"Providers":[{"Host":"news.example.com","Port":563,"UseSsl":true,"User":"<your-username>","Pass":"<your-password>","MaxConnections":10}]}
INFINIDYSK_USENET_PROVIDERS=

# ------------------------------------------------------------------------------
# 3. METADATA, ARTWORK, SUBTITLES & TRAKT SYNC (Leave blank if not needed)
# ------------------------------------------------------------------------------
# OpenSubtitles.com API Key (Optional, auto-downloads synchronized subtitles via SubSense)
OPENSUBTITLES_API_KEY=
# SubDL API Key (Optional, multilingual subtitles via SubSense)
SUBDL_API_KEY=
SUBSOURCE_API_KEY=
WYZIE_API_KEY=
# Trakt.tv Client ID & Secret (Optional, two-way scrobbling & watchlist sync via SlickSync)
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
# TheTVDB v4 API Key (Optional, enhances AIOMetadata anime/TV seasons: https://thetvdb.com/dashboard/account/apikeys)
TVDB_API_KEY=
# Rating Poster Database API Key (Optional, stamps IMDb/RT ratings onto posters: https://ratingposterdb.com/)
RPDB_API_KEY=
# Fanart.tv Personal API Key (Optional, enables 4K transparent logos & fanart: https://fanart.tv/get-an-api-key/)
FANART_API_KEY=
# MDBList API Key (Optional, enables dynamic Trakt/MDBList catalogs: https://mdblist.com/preferences/)
MDBLIST_API_KEY=
# Google Gemini API Key (Optional, enables AI episode recaps & translations: https://aistudio.google.com/)
GEMINI_API_KEY=

# ==============================================================================
# 4. OPTIONAL: INTERNAL SERVICE OVERRIDES (PUBLIC EXPOSURE ONLY)
# ==============================================================================
# 💡 ZERO PASSWORD CONFIGURATION REQUIRED FOR INTERNAL MICROSERVICES!
# All internal services (Postgres, Redis, Prowlarr, MediaFusion, Comet, Posters+,
# SubSense) communicate exclusively over the private Docker network (stremio-net)
# and are NOT exposed to the public internet.
#
# Docker Compose automatically wires and links them using secure pre-configured
# defaults. You NEVER need to define or touch these keys for normal operation.
#
# 🔒 PUBLIC EXPOSURE / HARDENING (OPTIONAL):
# Only uncomment and change these if you intend to directly publish raw database
# or internal scraper ports to the public internet without a reverse proxy / tunnel:
#
# SECRET_KEY=e2c019d4536f9a039b56f8f1dfba8919634e2c8846bb1999252c79213bc01b09
# POSTGRES_PASSWORD=postgres_supersecret_db_pass_2026
# PROWLARR_API_KEY=prowlarr_internal_secret_key_99
# MEDIAFLOW_PASS=supersecretmediaflowpass
# POSTERSPLUS_ACCESS_KEY=admin
ADMIN_EMAIL=admin@mediafusion.local
STREMTHRU_AUTH=
DEFAULT_PROXY_ID=
FORCE_PROXY_ENABLED=true

# ==============================================================================
# 5. COMMUNITY TEMPLATES & SEL AUTO-SYNC (PRE-LOADED AUTOMATICALLY)
# ==============================================================================
# Auto-syncs Tam-Taro Complete SEL & Vidhin05 TRaSH regex profiles upon container boot.
TEMPLATE_URLS=["https://raw.githubusercontent.com/Tam-Taro/SEL-Filtering-and-Sorting/refs/heads/main/Tamtaro-All-Templates-for-AIOStreams.json","https://raw.githubusercontent.com/Vidhin05/Releases-Regex/refs/heads/main/all-templates.json"]
TEMPLATE_REFRESH_INTERVAL=3600
WHITELISTED_SYNC_REFRESH_INTERVAL=3600
FEATURED_TEMPLATE_IDS=tamtaro.complete,Vidhin05.regex-template,Vidhin05.english-template
SEL_SYNC_ACCESS=all
WHITELISTED_REGEX_PATTERNS_URLS=["https://raw.githubusercontent.com/Vidhin05/Releases-Regex/main/English/regexes.json","https://raw.githubusercontent.com/Vidhin05/Releases-Regex/main/German/regexes.json","https://raw.githubusercontent.com/Tam-Taro/SEL-Filtering-and-Sorting/refs/heads/main/AIOStreams-SyncedURLs/Tamtaro-synced-excluded-regex.json","https://raw.githubusercontent.com/Tam-Taro/SEL-Filtering-and-Sorting/refs/heads/main/AIOStreams-SyncedURLs/Tamtaro-synced-french-regex.json","https://raw.githubusercontent.com/Tam-Taro/SEL-Filtering-and-Sorting/refs/heads/main/AIOStreams-SyncedURLs/Tamtaro-synced-for-nour-Regex.json","https://git.tamtaro.de/Excluded-Regex.json"]
WHITELISTED_SEL_URLS=["https://raw.githubusercontent.com/Tam-Taro/SEL-Filtering-and-Sorting/refs/heads/main/AIOStreams-SyncedURLs/Tamtaro-synced-ESEs-extended.json","https://raw.githubusercontent.com/Tam-Taro/SEL-Filtering-and-Sorting/refs/heads/main/AIOStreams-SyncedURLs/Tamtaro-synced-ESEs-standard.json","https://raw.githubusercontent.com/Tam-Taro/SEL-Filtering-and-Sorting/refs/heads/main/AIOStreams-SyncedURLs/Tamtaro-synced-ISEs.json","https://raw.githubusercontent.com/Tam-Taro/SEL-Filtering-and-Sorting/refs/heads/main/AIOStreams-SyncedURLs/Tamtaro-synced-PSEs.json","https://raw.githubusercontent.com/Tam-Taro/SEL-Filtering-and-Sorting/refs/heads/main/AIOStreams-SyncedURLs/Tamtaro-synced-french-RSE.json","https://raw.githubusercontent.com/Tam-Taro/SEL-Filtering-and-Sorting/refs/heads/main/AIOStreams-SyncedURLs/Tamtaro-synced-for-nour-RSE.json","https://raw.githubusercontent.com/Vidhin05/Releases-Regex/main/English/expressions.json","https://raw.githubusercontent.com/Vidhin05/Releases-Regex/main/German/expressions.json","https://raw.githubusercontent.com/Vidhin05/Releases-Regex/main/English/legacy-expressions.json","https://git.tamtaro.de/PSE.json","https://git.tamtaro.de/ESE.json","https://git.tamtaro.de/ISE.json"]

# ==============================================================================
# 6. ZILEAN MULTI-CORE TUNING & CPU BALANCING (OPTIONAL)
# ==============================================================================
# ZILEAN_THREADS=4                   # Number of worker threads across cores (spreads load across CPU cores)
# ZILEAN_CPU_LIMIT=2.0               # Max total CPU quota across all cores (e.g. 2.0 = 200% total shared across cores)
# ZILEAN_CPU_SHARES=256              # Low priority scheduling (yields CPU to Stremio/AIOStreams when busy)
# ZILEAN_BATCH_SIZE=1000             # Smaller batch size for smoother parsing bursts & lower RAM spikes
# ZILEAN_MEM_LIMIT=2048m             # Max RAM limit
# ZILEAN_ENABLE_SCRAPING=true        # Set to false to disable DMM background indexing completely (drops to 0% CPU)
# ZILEAN_SCRAPE_SCHEDULE=0 4 * * *   # Syncs once daily at 4 AM instead of hourly

# ==============================================================================
# 7. SERVICE PORT & URL OVERRIDES (OPTIONAL - FOR HOST PORT CONFLICTS)
# ==============================================================================
# PORT_SUBSENSE=3100                 # SubSense subtitle aggregator (Change to 3110 if 3100 is allocated on host)
# PORT_SOOTIO=55771                  # Sootio direct scraper port
# SOOTIO_URL=http://localhost:55771  # Public/base URL for Sootio
# MEDIAFUSION_HOST_URL=http://localhost:8001 # Public/LAN URL for MediaFusion stream redirection (auto-derived from BASE_URL:8001 if blank)
# MEDIAFUSION_SCRAPE_PROWLARR=false  # Set to true to query Prowlarr trackers live in MediaFusion (default: false, uses instant local Zilean cache)
# MEDIAFUSION_PUBLIC=true            # Controls MediaFusion public instance mode
# AIOMETADATA_HOST=http://localhost:4005 # Public host URL for AIOMetadata
# DEBRID_SEARCH_URL=http://localhost:3011 # Public URL for Stremio-IntellDebridSearch
# RESET_ADMIN_PASSWORD=false         # Set to true to reset InfiniDysk admin credentials

