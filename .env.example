# ==============================================================================
#                      ALL-IN-ONE LOCAL STREMIO APPLIANCE (.env)
# ==============================================================================
# 💡 THE GOLDEN RULE: WHAT IS ACTUALLY NEEDED?
# You only need to configure 3 simple values to start streaming immediately:
#   1. BASE_URL          -> Your server domain or local IP (e.g. http://localhost:3001)
#   2. DEBRID API TOKEN  -> Pick just ONE service (Real-Debrid, TorBox, or AllDebrid)
#   3. TMDB_API_KEY      -> Free metadata API key from themoviedb.org
#
# Everything else is either an OPTIONAL enhancement or PRE-CONFIGURED internally!
# ==============================================================================

# ==============================================================================
# 0. STACK PROFILES & RESOURCE TUNING
# ==============================================================================
# Choose which container profile to launch:
#   scrapers - Complete appliance with all scrapers, indexers, proxies, and Usenet (default)
#   core     - Fast, lean Debrid stack (AIOStreams, Prowlarr, AIOMetadata, Posters+, SubSense, DBs) [~1.1 GB RAM]
#   all      - Full stack with optional integrations
COMPOSE_PROFILES=core

# ==============================================================================
# 1. CORE STREAMING SETTINGS (REQUIRED)
# ==============================================================================
# Public HTTPS URL of your AIOStreams instance (Required for Stremio client install)
# Connected via Cloudflare Tunnel or reverse proxy to host port 3001
BASE_URL=https://aio.yourdomain.com
PORT_AIOSTREAMS=3001

# Public HTTPS URL of your AIOMetadata instance (External catalog & metadata addon)
# Connected via Cloudflare Tunnel or reverse proxy to host port 4005
AIOMETADATA_HOST=https://aiometa.yourdomain.com
PORT_AIOMETADATA=4005

# Built-in Media Server (Jellyfin) & AIOStreams Web Player (Default: true)
# AIOStreams bundles a Jellyfin-compatible server and official WebGPU/HLS web player
# directly at ${BASE_URL}/jellyfin/web and web.aiostreams.org.
# Features:
#   • Direct browser playback of movies, series, and anime (HEVC, Dolby Vision, TrueHD/DTS audio passthrough)
#   • Styled ASS/SSA subtitle rendering via libass & real-time anime upscaling
#   • Connects to Jellyfin client apps (Infuse, Swiftfin, Findroid, Kodi) & native AIOStreams desktop/mobile/TV apps
#   • 1-Click Quick Connect authentication via ${BASE_URL}/jellyfin/quickconnect
JELLYFIN_ENABLED=true
# Invited isolated player profiles sign in with their own PIN, never the admin password.
JELLYFIN_PIN_SIGN_IN=true

# Security & Host Port Binding
# Only AIOStreams (3001) and AIOMetadata (4005) are published for external remote streaming.
# Internal microservices (Prowlarr, Posters+, etc.) bind to 127.0.0.1
# to protect against unfirewalled exposure on a VPS or public IP.
# If you run on a private home LAN NAS and want direct LAN access to internal dashboards, set to 0.0.0.0.
INTERNAL_BIND_IP=127.0.0.1

# Master Password (ADDON_PASSWORD)
# 🔑 UNIFIES & PROTECTS INTERNAL WEB DASHBOARDS:
#   • AIOStreams (:3001)    • AIOMetadata (:4005)
#   • Posters+ (:9039)      • StremThru (:8080)
ADDON_PASSWORD=

# Portal Password Protection (Default: false)
# When false (default), the portal on :8088 is open for easy local access without login popups.
# Set to true if exposing port 8088 to the public internet without a reverse proxy.
PORTAL_AUTH_REQUIRED=false

# TMDB v3 API Key (Required for movie/series metadata: https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# ------------------------------------------------------------------------------
# 2. STREAMING PROVIDER MODE & CREDENTIALS
# ------------------------------------------------------------------------------
# Choose your backend mode:
#   debrid : Standard high-speed cached torrent streaming (Real-Debrid, TorBox, Premiumize...) [Default]
#   usenet : Pure Usenet streaming via direct Newznab presets in AIOStreams (~250ms search, NO Debrid required!)
#   hybrid : Both Debrid + Usenet configured with automatic cross-protocol failover
STREAMING_MODE=debrid

# --- Debrid Providers (Provide at least ONE if in Debrid or Hybrid mode) ---
# Real-Debrid API Token (from https://real-debrid.com/apitoken)
REALDEBRID_API_KEY=
# TorBox API Token (from https://torbox.app/settings)
TORBOX_API_KEY=
# AllDebrid API Key (from https://alldebrid.com/apikeys)
ALLDEBRID_API_KEY=
# Premiumize API Key (from https://www.premiumize.me/account)
PREMIUMIZE_API_KEY=
# Debrid-Link API Key (from https://debrid-link.com/webapp/register)
DEBRIDLINK_API_KEY=
# EasyDebrid API Key (Optional)
EASYDEBRID_API_KEY=
# Offcloud API Key (Optional)
OFFCLOUD_API_KEY=
# Seedr Token (Optional)
SEEDR_API_KEY=
# EasyNews Direct Search & Streaming (Optional - direct Usenet search & web streaming)
EASYNEWS_USER=
EASYNEWS_PASSWORD=
# Additional native anime sources are opt-in; compatible services are selected automatically.
ENABLE_ANIME_SOURCES=false

# ------------------------------------------------------------------------------
# 2B. USENET (NNTP) CREDENTIALS (FOR ON-DEMAND USENET STREAMING)
# ------------------------------------------------------------------------------
# Usenet Server Hostname (e.g. news.eweka.nl, news.usenet.farm, or secure.news.easynews.com)
USENET_ENABLED=false
USENET_HOST=
USENET_PORT=563
USENET_USER=
USENET_PASS=
USENET_SSL=true
USENET_CONNECTIONS=10
# The portal safely encodes credentials before saving; these are still secrets.
USENET_USER_B64=
USENET_PASS_B64=
USENET_MANAGED=
# Direct Newznab Indexers (configured directly in AIOStreams with ~250ms parallel search)
# NZB indexers (e.g. altHUB, DrunkenSlug, AnimeTosho) query native Newznab endpoints directly in AIOStreams,
# while Prowlarr is dedicated 100% to torrent indexing.
NZB_INDEXER_URL=
NZB_INDEXER_API_KEY=

# ------------------------------------------------------------------------------
# 3. METADATA, ARTWORK, SUBTITLES & TRAKT SYNC (Leave blank if not needed)
# ------------------------------------------------------------------------------
# OpenSubtitles.com API Key (Optional, auto-downloads synchronized subtitles via SubSense)
OPENSUBTITLES_API_KEY=
# SubDL API Key (Optional, multilingual subtitles via SubSense)
SUBDL_API_KEY=
SUBSOURCE_API_KEY=
WYZIE_API_KEY=
# Trakt.tv Client ID & Secret (Optional, two-way scrobbling & watchlist sync)
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
# TheTVDB v4 API Key (Optional, enhances AIOMetadata anime/TV seasons: https://thetvdb.com/dashboard/account/apikeys)
TVDB_API_KEY=
# Rating Poster Database API Key (Optional, stamps IMDb/RT ratings onto posters: https://ratingposterdb.com/)
RPDB_API_KEY=
# Fanart.tv Personal API Key (Optional, enables 4K transparent logos & fanart: https://fanart.tv/get-an-api-key/)
FANART_API_KEY=
# MDBList API Key (Optional, enables dynamic Trakt/MDBList catalogs: https://mdblist.com/preferences/)
MDBLIST_API_KEY=
# Google Gemini API Key (Optional, enables AI episode recaps & translations: https://aistudio.google.com/)
GEMINI_API_KEY=
# Simkl Client ID (Optional, watchlist sync & anime tracking via AIOMetadata: https://simkl.com/settings/developer/)
SIMKL_CLIENT_ID=
# AniList Token (Optional, anime list sync & tracking via AIOMetadata: https://anilist.co/settings/developer)
ANILIST_TOKEN=

# ==============================================================================
# 4. OPTIONAL: INTERNAL SERVICE OVERRIDES (PUBLIC EXPOSURE ONLY)
# ==============================================================================
# 💡 ZERO PASSWORD CONFIGURATION REQUIRED FOR INTERNAL MICROSERVICES!
# All internal services (Postgres, Redis, Prowlarr, Posters+,
# SubSense) communicate exclusively over the private Docker network (stremio-net)
# and are NOT exposed to the public internet.
#
# Docker Compose automatically wires and links them using secure pre-configured
# defaults. You NEVER need to define or touch these keys for normal operation.
#
# 🔒 PUBLIC EXPOSURE / HARDENING (OPTIONAL):
# Only uncomment and change these if you intend to directly publish raw database
# or internal scraper ports to the public internet without a reverse proxy / tunnel:
#
# SECRET_KEY=e2c019d4536f9a039b56f8f1dfba8919634e2c8846bb1999252c79213bc01b09
# POSTGRES_PASSWORD=postgres_supersecret_db_pass_2026
# PROWLARR_API_KEY=prowlarr_internal_secret_key_99
# PROWLARR_EXTRA_INDEXERS=           # Optional comma-separated list of extra indexer slugs (e.g. 1337x,anidex)
# POSTERSPLUS_ACCESS_KEY=admin        # Access key for Posters+ (defaults to ADDON_PASSWORD/master password)
STREMTHRU_AUTH=
# Cloudflare Zero-Trust Tunnel Token (Optional: enable "tunnel" profile to expose ports 3001 & 4005 without opening ports)
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------------------------
# 4B. PROXY & MULTI-IP BAN SHIELD (ENFORCED SERVER-SIDE PROXYING)
# ------------------------------------------------------------------------------
# Ensures ALL streams route exclusively through this server's IP address.
# Prevents account bans from debrid providers (Real-Debrid, Premiumize) when multiple
# household devices or family members stream concurrently from different IPs.
# Also shields client IPs for non-debrid scrapers/IPTV/hosters ("none").
FORCE_PROXY_ENABLED=true
FORCE_PROXY_ID=builtin
FORCE_PROXY_PROXIED_SERVICES=["realdebrid","premiumize","alldebrid","torbox","debridlink","easynews","none"]

# StremThru Store (Debrid Personal Cloud library mounted directly in Stremio as a catalog)
STREMTHRU_STORE_URL=http://stremthru:8080/stremio/store/

# ==============================================================================
# 5. COMMUNITY TEMPLATES & SEL AUTO-SYNC (PRE-LOADED AUTOMATICALLY)
# ==============================================================================
# Auto-syncs Tam-Taro Complete SEL & Vidhin05 TRaSH regex profiles upon container boot.
TEMPLATE_URLS=["https://raw.githubusercontent.com/Tam-Taro/SEL-Filtering-and-Sorting/refs/heads/main/Tamtaro-All-Templates-for-AIOStreams.json","https://raw.githubusercontent.com/Vidhin05/Releases-Regex/refs/heads/main/all-templates.json"]
TEMPLATE_REFRESH_INTERVAL=3600
WHITELISTED_SYNC_REFRESH_INTERVAL=3600
FEATURED_TEMPLATE_IDS=tamtaro.complete,Vidhin05.regex-template,Vidhin05.english-template
SEL_SYNC_ACCESS=all
WHITELISTED_REGEX_PATTERNS_URLS=["https://raw.githubusercontent.com/Vidhin05/Releases-Regex/main/English/regexes.json","https://raw.githubusercontent.com/Vidhin05/Releases-Regex/main/German/regexes.json","https://raw.githubusercontent.com/Tam-Taro/SEL-Filtering-and-Sorting/refs/heads/main/AIOStreams-SyncedURLs/Tamtaro-synced-excluded-regex.json","https://raw.githubusercontent.com/Tam-Taro/SEL-Filtering-and-Sorting/refs/heads/main/AIOStreams-SyncedURLs/Tamtaro-synced-french-regex.json","https://raw.githubusercontent.com/Tam-Taro/SEL-Filtering-and-Sorting/refs/heads/main/AIOStreams-SyncedURLs/Tamtaro-synced-for-nour-Regex.json","https://git.tamtaro.de/Excluded-Regex.json"]
WHITELISTED_SEL_URLS=["https://raw.githubusercontent.com/Tam-Taro/SEL-Filtering-and-Sorting/refs/heads/main/AIOStreams-SyncedURLs/Tamtaro-synced-ESEs-extended.json","https://raw.githubusercontent.com/Tam-Taro/SEL-Filtering-and-Sorting/refs/heads/main/AIOStreams-SyncedURLs/Tamtaro-synced-ESEs-standard.json","https://raw.githubusercontent.com/Tam-Taro/SEL-Filtering-and-Sorting/refs/heads/main/AIOStreams-SyncedURLs/Tamtaro-synced-ISEs.json","https://raw.githubusercontent.com/Tam-Taro/SEL-Filtering-and-Sorting/refs/heads/main/AIOStreams-SyncedURLs/Tamtaro-synced-PSEs.json","https://raw.githubusercontent.com/Tam-Taro/SEL-Filtering-and-Sorting/refs/heads/main/AIOStreams-SyncedURLs/Tamtaro-synced-french-RSE.json","https://raw.githubusercontent.com/Tam-Taro/SEL-Filtering-and-Sorting/refs/heads/main/AIOStreams-SyncedURLs/Tamtaro-synced-for-nour-RSE.json","https://raw.githubusercontent.com/Vidhin05/Releases-Regex/main/English/expressions.json","https://raw.githubusercontent.com/Vidhin05/Releases-Regex/main/German/expressions.json","https://raw.githubusercontent.com/Vidhin05/Releases-Regex/main/English/legacy-expressions.json","https://git.tamtaro.de/PSE.json","https://git.tamtaro.de/ESE.json","https://git.tamtaro.de/ISE.json"]

# ==============================================================================
# 6. ZILEAN CPU & BACKGROUND INDEXING (OPTIONAL)
# ==============================================================================
# BUILTIN_ZILEAN_URL=http://zilean:8181         # Direct local Zilean endpoint (60x faster than WAN)
# BUILTIN_DEFAULT_ZILEAN_TIMEOUT=5000           # Fast local timeout for Zilean requests (ms)
# ZILEAN_THREADS=2                   # .NET processor-count hint; does not guarantee even core usage
# ZILEAN_CPU_LIMIT=0.5               # Total CPU-time cap (~50% in Docker stats); indexing takes longer
# ZILEAN_CPU_SHARES=256              # Low priority scheduling (yields CPU to Stremio/AIOStreams when busy)
# ZILEAN_BATCH_SIZE=500             # Smaller batch size for smoother parsing bursts & lower RAM spikes
# ZILEAN_MEM_LIMIT=3072m             # Max RAM limit
# ZILEAN_ENABLE_SCRAPING=true        # Set to false to disable DMM background indexing; searches still use CPU
# ZILEAN_SCRAPE_SCHEDULE=0 4 * * *   # Syncs once daily at 4 AM instead of hourly

# ==============================================================================
# 7. SERVICE PORT & URL OVERRIDES (OPTIONAL - FOR HOST PORT CONFLICTS)
# ==============================================================================
# Service Port & Web Interface Classification:
#
# --- Interactive Web Admin Panels & Players (Browser / Modal Accessible) ---
#   • Portal (:8088)          : Fleet dashboard & setup manager (/)
#   • AIOStreams (:3001)      : Configurator (/configure), Web Player (/jellyfin/web), Admin (/admin)
#   • AIOMetadata (:4005)     : Catalog, metadata & tracking configurator (/configure)
#   • Prowlarr (:9696)        : Torrent / Usenet indexer manager (/)
#   • Zilean (:8181)          : DMM torrent cache memory indexer (/)
#   • StremThru (:8080)       : Debrid proxy & personal cloud store (/)
#   • Posters+ (:9039)        : IMDb / Rotten Tomatoes rating badge admin (/admin)
#   • Anime Kitsu (:7005)     : Kitsu anime catalog engine (/)
#
# --- Internal Background Daemons (Headless Microservices / Private Network) ---
#   • PostgreSQL (shared-postgres) : Internal database storage (stremio-net private network only; no host port)
#   • Redis (shared-redis)         : In-memory cache & rate limiter (stremio-net private network only; no host port)
#   • FlareSolverr (:8191)         : Headless anti-bot challenge solver daemon (JSON API only; binds to 127.0.0.1)
#
# PORT_PORTAL=8088                   # Portal management UI
# PORT_AIOSTREAMS=3001               # AIOStreams aggregator & Jellyfin server
# PORT_AIOMETADATA=4005              # AIOMetadata catalog server
# PORT_SUBSENSE=3100                 # SubSense subtitle aggregator (Change to 3110 if 3100 is allocated on host)
# AIOMETADATA_HOST=http://localhost:4005 # Public host URL for AIOMetadata
# LUMIERE_API_BASE=http://lumiere-db:8000 # Local SQLite FTS5 IMDb search index for AIOMetadata
# LUMIERE_SEARCH_TIMEOUT_MS=5000     # Search query timeout (ms)
# LUMIERE_SEARCH_TTL_SECONDS=86400   # Cache duration for search results (seconds)
# LUMIERE_SEARCH_RESULT_LIMIT=12     # Maximum search results returned by LumiereDB (1-50)
# JIKAN_API_BASE=https://api.tenrai.org/v4 # Jikan REST API v4 for AIOMetadata anime schedules & fillers (Tenrai free endpoint or self-hosted)
# LUMIERE_MEM_LIMIT=512m             # RAM cap for LumiereDB search index

# ==============================================================================
# 8. RESOURCE LIMITS & LIGHTWEIGHT TUNING (OPTIONAL)
# ==============================================================================
# Fine-tune container RAM boundaries for low-memory VPS (2GB-4GB) or home servers.
# The stack includes built-in V8 heap limits, Go memory boundaries, and worker tuning
# to run comfortably under ~2 GB total RAM.
#
# AIOSTREAMS_MEM_LIMIT=512m          # Aggregator heap limit (default: 512m)
# STREMTHRU_MEM_LIMIT=768m           # Debrid proxy limit (default: 768m, GOMEMLIMIT=384MiB)
# SUBSENSE_MEM_LIMIT=384m            # Subtitle service limit (default: 384m)
SUBSENSE_WARP_ENABLED=false          # Enable only on Docker hosts that provide tunnel access
# AIOMETADATA_MEM_LIMIT=512m         # Metadata & catalog limit (default: 512m)
# PROWLARR_MEM_LIMIT=384m            # Prowlarr indexer limit (default: 384m)
# POSTERSPLUS_MEM_LIMIT=384m         # Posters+ badge limit (default: 384m)
# KITSU_MEM_LIMIT=256m               # Anime Kitsu limit (default: 256m)
# FLARESOLVERR_MEM_LIMIT=1024m       # Byparr / Camoufox browser limit (default: 1024m)
# POSTGRES_MEM_LIMIT=512m            # PostgreSQL limit (default: 512m)
# REDIS_MEM_LIMIT=256m               # Redis limit (default: 256m)



# Tracking apps: authorize individual accounts in AIOMetadata after setup.
SIMKL_CLIENT_SECRET=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
# ANILIST_TOKEN is legacy and is not used as an OAuth token-record ID.

# Bounded Prowlarr request sharing and failure backoff. No public port is exposed.
SEARCH_TIMEOUT=8
SEARCH_WORKERS=4
SEARCH_CACHE_TTL=60
SEARCH_FAILURE_COOLDOWN=120

# AIOStreams Stream & Pipeline Caching (prevents repeated upstream scraper queries)
STREAM_CACHE_TTL=1800
PIPELINE_CACHE_TTL=1800

# ==============================================================================
# 9. PUBLIC & COMMUNITY DATABASES (OPTIONAL ENHANCEMENTS)
# ==============================================================================
# Selectable external and curated databases that supplement your local scrapers:
#
# 1. Torrentio: Queries the upstream public index database (~30ms lookup) for millions of
# cached releases. Runs directly through AIOStreams with BuiltinProxy protection.
ENABLE_TORRENTIO=true
# TORRENTIO_URL=https://torrentio.strem.fun # Optional custom Torrentio URL override

# 2. RemuxDB: Sourced by AIOStreams to fetch MediaInfo probe data, true lossless audio
# codecs (TrueHD/Atmos, DTS-HD MA), and HDR10+/Dolby Vision container profiles.
ENABLE_REMUXDB=true

# 3. DMM Database (Debrid Media Manager): Syncs curated community hashlists into
# local Zilean for instant (<50ms) cached torrent hash matches.
ENABLE_DMM=true

# 4. Intro & Credit Skipping (Segments): Auto-queries IntroDB, Anime Skip, and PublicMetaDB
# to detect intro and outro segments for automated or one-click skipping in supported players.

# 5. Watch State & Multi-Persona Sync: Persistent watch progress tracking (positionMs),
# favorites, history sync across Jellyfin/Stremio apps, and SyncPlay/Party watch sessions (/party, /syncplay).

# 6. Arr & Downloader Integration APIs:
# Built-in SABnzbd-compatible endpoint for Radarr/Sonarr (/api/v1/sabnzbd) and Newznab/Torznab search feeds.

# Warm the next episode's search results in the background when TMDB is configured.
# Search only: no automatic downloads or playback-link probes. Set false to disable.
AIO_PRECACHE_NEXT_EPISODE=true

# ==============================================================================
# 10. AUTOMATED BACKUPS & WATCHDOG (OPTIONAL)
# ==============================================================================
# Automated Stack Backup Schedule: daily, weekly, or off (default: daily)
# Archives SQLite DBs, environment configs, and PostgreSQL dumps automatically.
BACKUP_SCHEDULE=daily

